{
  "name": "deepseek-lite",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:import": "tsc -p scripts/tsconfig.json && node .test-dist/scripts/test-import.js && node .test-dist/scripts/test-memory.js && node .test-dist/scripts/test-assemble.js",
    "demo:prompt": "tsc -p scripts/tsconfig.json && node .test-dist/scripts/demo-prompt.js",
    "fix:deps": "expo install --fix"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "punycode": "2.3.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
