{
  "expo": {
    "name": "DeepSeek Lite",
    "slug": "deepseek-lite",
    "version": "0.1.0",
    "scheme": "deepseeklite",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4D6BFE"
    },
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dslite.app"
    },
    "android": {
      "package": "com.dslite.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foreground": "./assets/adaptive-icon.png",
        "backgroundColor": "#4D6BFE"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
