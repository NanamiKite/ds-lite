{
  "expo": {
    "name": "DS Lite",
    "slug": "ds-lite",
    "version": "0.1.0",
    "scheme": "dslite",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4D6BFE"
    },
    "backgroundColor": "#FFFFFF",
    "newArchEnabled": true,
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.dslite.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foreground": "./assets/adaptive-icon.png",
        "background": "./assets/adaptive-icon-background.png",
        "monochrome": "./assets/adaptive-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
